APP_NAME=Dimensimatic
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=http://127.0.0.1:8012
DIMENSIMATIC_APP_VERSION=1.1.104
DIMENSIMATIC_UPDATE_REPOSITORY=fachry2204/dimensimatic
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
DB_CONNECTION=sqlite
# Desktop sessions deliberately use the filesystem rather than SQLite.  Queue
# workers also write to SQLite, and sharing it with browser sessions can cause
# a CSRF session to disappear while a login request is being completed.
SESSION_DRIVER=file
SESSION_COOKIE=dimensimatic_session
SESSION_LIFETIME=1440
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3600
CACHE_STORE=database
FILESYSTEM_DISK=local
PLAYWRIGHT_SERVICE_URL=http://127.0.0.1:3112
AUTOMATION_HMAC_KEY=__HMAC_KEY__

# Default CMS login; editable in Pengaturan Platform.
CMS_LOGIN_URL=https://dimensisuara.id/login
