<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Dimensimatic-Setup</AssemblyName><Version>1.1.106</Version>
    <ApplicationIcon>..\assets\dimensimatic-icon.ico</ApplicationIcon><Product>Dimensimatic Setup</Product><Title>Dimensimatic Setup</Title><Company>Dimensi Suara</Company>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.7z" LogicalName="Dimensimatic.payload.7z" />
    <EmbeddedResource Include="7z.exe" LogicalName="Dimensimatic.7z.exe" />
    <EmbeddedResource Include="7z.dll" LogicalName="Dimensimatic.7z.dll" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
